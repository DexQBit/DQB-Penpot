# DexQBit Penpot — example env for Hetzner deploy
# Copy to .env next to docker-compose.yml on the VPS (never commit .env).

PENPOT_PUBLIC_URI=https://penpot.example.com
PENPOT_SECRET_KEY=replace-with-secrets-token-urlsafe-64

# Published HTTP port (host:container). Frontend nginx listens on 8080 in the image.
PENPOT_HTTP_PORT=9001
PENPOT_HTTP_CONTAINER_PORT=8080

# GHCR images (after CI push). Replace owner/tag as needed.
PENPOT_IMAGE_FRONTEND=ghcr.io/dexqbit/penpot-frontend:latest
PENPOT_IMAGE_BACKEND=ghcr.io/dexqbit/penpot-backend:latest
PENPOT_IMAGE_EXPORTER=ghcr.io/dexqbit/penpot-exporter:latest

PENPOT_DATABASE_PASSWORD=replace-me

# Google Workspace OAuth (Google Cloud Console → OAuth client)
# Authorized redirect URI: https://penpot.example.com/api/auth/oidc/callback
PENPOT_GOOGLE_CLIENT_ID=
PENPOT_GOOGLE_CLIENT_SECRET=

# Comma-separated platform admin emails (must be @dexqbit.com accounts that have logged in once)
PENPOT_ADMINS=admin@dexqbit.com

# SMTP
PENPOT_SMTP_DEFAULT_FROM=Penpot <noreply@dexqbit.com>
PENPOT_SMTP_DEFAULT_REPLY_TO=Penpot <noreply@dexqbit.com>
PENPOT_SMTP_HOST=
PENPOT_SMTP_PORT=587
PENPOT_SMTP_USERNAME=
PENPOT_SMTP_PASSWORD=
PENPOT_SMTP_TLS=true
PENPOT_SMTP_SSL=false
